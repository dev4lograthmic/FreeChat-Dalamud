<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Author>FreeChat</Author>
    <Name>FreeChat</Name>
    <Punchline>Receive and send FFXIV chat from your own clients.</Punchline>
    <Description>Game-side WebSocket server for the FreeChat protocol. Pair a trusted client, receive chat events, and send commands or messages.</Description>
    <RepoUrl>https://github.com/dev4lograthmic/FreeChat-Dalamud</RepoUrl>
    <Tags>chat;server;lan;websocket</Tags>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FreeChat.Dalamud</AssemblyName>
    <RootNamespace>FreeChat.Dalamud</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeChat.Protocol\FreeChat.Protocol.csproj" />
    <ProjectReference Include="..\FreeChat.Server\FreeChat.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>
</Project>
